{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lalannns/mm-ai-arc3-ar25/schemas/experiment_qa_schema.json",
  "title": "AR25 experiment-level QA dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_run",
    "experiment_id",
    "signature_hash",
    "question",
    "answer",
    "answer_grounding",
    "step_count",
    "action_sequence",
    "outcome",
    "final_state",
    "levels_completed_start",
    "levels_completed_end",
    "total_changed_cells",
    "initial_frame_path",
    "intermediate_frame_paths",
    "final_frame_path",
    "frame_shape"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "source_run": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "signature_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "question": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 },
    "answer_grounding": {
      "type": "string",
      "enum": ["observed_sequence_metadata"]
    },
    "step_count": { "type": "integer", "minimum": 1 },
    "action_sequence": { "type": "string", "minLength": 2 },
    "outcome": { "type": "string", "minLength": 1 },
    "final_state": {
      "type": ["string", "null"],
      "enum": ["NOT_PLAYED", "NOT_FINISHED", "WIN", "GAME_OVER", null]
    },
    "levels_completed_start": { "type": ["integer", "null"], "minimum": 0 },
    "levels_completed_end": { "type": ["integer", "null"], "minimum": 0 },
    "total_changed_cells": { "type": "integer", "minimum": 0 },
    "initial_frame_path": { "type": "string", "pattern": "\\.npy$" },
    "intermediate_frame_paths": { "type": "string", "minLength": 2 },
    "final_frame_path": { "type": "string", "pattern": "\\.npy$" },
    "frame_shape": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" }
  }
}
