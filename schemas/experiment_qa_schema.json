{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lalannns/mm-ai-arc3-ar25/schemas/experiment_qa_schema.json",
  "title": "AR25 experiment-level trajectory QA dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "source_run", "experiment_id", "signature_hash", "hash_version",
    "question", "answer", "answer_grounding", "step_count", "action_sequence",
    "prefix_actions", "prefix_actions_provenance", "trajectory_manifest", "outcome",
    "final_state", "levels_completed_start", "levels_completed_start_provenance",
    "levels_completed_end", "levels_completed_end_provenance", "total_changed_cells",
    "total_changed_cells_semantics", "initial_frame_hash", "final_frame_hash",
    "initial_frame_path", "intermediate_frame_paths", "final_frame_path", "frame_shape"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_run": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "signature_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_version": {"const": "ar25-pixel-trajectory-v2"},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "answer_grounding": {"enum": ["observed_raw_metadata", "partially_unknown_raw_metadata"]},
    "step_count": {"type": "integer", "minimum": 1},
    "action_sequence": {"type": "string", "minLength": 2},
    "prefix_actions": {"type": "string", "minLength": 2},
    "prefix_actions_provenance": {"enum": ["observed", "reconstructed", "unknown"]},
    "trajectory_manifest": {"type": "string", "minLength": 2},
    "outcome": {"enum": ["changed", "no_visible_change", "changed_then_returned_to_start", "level_progress"]},
    "recorded_outcome": {"type": "string", "minLength": 1},
    "outcome_provenance": {"enum": ["recomputed_from_observed_levels", "recomputed_from_pixel_sequence", "recorded_unverified"]},
    "final_state": {"type": ["string", "null"], "enum": ["NOT_PLAYED", "NOT_FINISHED", "WIN", "GAME_OVER", null]},
    "levels_completed_start": {"type": ["integer", "null"], "minimum": 0},
    "levels_completed_start_provenance": {"enum": ["observed", "reconstructed", "unknown"]},
    "levels_completed_end": {"type": ["integer", "null"], "minimum": 0},
    "levels_completed_end_provenance": {"enum": ["observed", "reconstructed", "unknown"]},
    "total_changed_cells": {"type": "integer", "minimum": 0},
    "total_changed_cells_semantics": {"const": "sum_of_per_step_full_frame_changed_cells; cells may be counted more than once"},
    "initial_frame_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_frame_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initial_frame_path": {"type": "string", "pattern": "\\.npy$"},
    "intermediate_frame_paths": {"type": "string", "minLength": 2},
    "final_frame_path": {"type": "string", "pattern": "\\.npy$"},
    "frame_shape": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"}
  }
}
