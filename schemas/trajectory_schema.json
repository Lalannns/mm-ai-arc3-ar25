{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lalannns/mm-ai-arc3-ar25/schemas/trajectory_schema.json",
  "title": "AR25 trajectory dataset",
  "type": "object",
  "required": ["trajectory_id", "game_id", "steps"],
  "properties": {
    "trajectory_id": { "type": "string", "minLength": 1 },
    "game_id": { "type": "string", "minLength": 1 },
    "seed": { "type": ["integer", "null"] },
    "final_state": { "$ref": "#/$defs/game_state" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "game_state": {
      "type": ["string", "null"],
      "enum": ["NOT_PLAYED", "NOT_FINISHED", "WIN", "GAME_OVER", null]
    },
    "action": {
      "type": "string",
      "enum": ["ACTION1", "ACTION2", "ACTION3", "ACTION4", "ACTION5", "ACTION6", "ACTION7"]
    },
    "grid": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 64,
        "maxItems": 64,
        "items": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "image": {
      "type": "object",
      "required": ["bytes", "path"],
      "properties": {
        "bytes": {},
        "path": { "type": "string", "pattern": "\\.png$" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "source",
        "episode_id",
        "step",
        "action",
        "action_id",
        "action_data",
        "before_state",
        "after_state",
        "levels_completed",
        "changed_pixels",
        "observation",
        "transition_hash",
        "is_duplicate",
        "raw_reasoning",
        "grid_before",
        "grid_after",
        "image_before",
        "image_after",
        "reasoning",
        "reasoning_source",
        "instruction",
        "answer"
      ],
      "properties": {
        "sample_id": { "type": "string", "pattern": "^.+_step[0-9]{3}$" },
        "source": {
          "type": "string",
          "pattern": "^(sequences\\.jsonl|transitions\\.jsonl|logs/.+\\.json|exploration/[^/]+)$"
        },
        "episode_id": { "type": "string", "minLength": 1 },
        "step": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/action" },
        "action_id": { "type": "integer", "minimum": 1, "maximum": 7 },
        "action_data": { "type": "string" },
        "before_state": { "$ref": "#/$defs/game_state" },
        "after_state": { "$ref": "#/$defs/game_state" },
        "levels_completed": { "type": ["integer", "null"], "minimum": 0 },
        "changed_pixels": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "observation": { "type": "string", "minLength": 1 },
        "transition_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "is_duplicate": { "type": "boolean" },
        "raw_reasoning": { "type": ["string", "null"] },
        "grid_before": { "$ref": "#/$defs/grid" },
        "grid_after": { "$ref": "#/$defs/grid" },
        "image_before": { "$ref": "#/$defs/image" },
        "image_after": { "$ref": "#/$defs/image" },
        "reasoning": { "type": "string", "minLength": 1 },
        "reasoning_source": { "type": "string", "pattern": "^(observed_diff|lisa:.+)$" },
        "instruction": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "pattern": "Action: ACTION[1-7]( x=[0-9]{1,2} y=[0-9]{1,2})?$" }
      }
    }
  }
}
